# Yelken Perde — Apache / LiteSpeed (cPanel) ayarları
DirectoryIndex index.php index.html
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Veri ve kod klasörlerine doğrudan erişim yok
  RewriteRule ^(data|inc)(/|$) - [F,L]

  # Sitemap panelde eklenen blog yazılarıyla birlikte otomatik üretilir
  RewriteRule ^sitemap\.xml$ sitemap.php [L]

  # Panelden yönetilen sayfalar (.html ve uzantısız eski adresler)
  RewriteRule ^(index|galeri|urunler|blog)(\.html)?$ $1.php [L,QSA]
  RewriteRule ^blog/$ blog.php [L,QSA]

  # Blog yazıları: tasarımlı sabit sayfa (blog/yazi.html) varsa o açılır, yoksa panel yazısı
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME}.html !-f
  RewriteRule ^blog/([a-z0-9-]+)(\.html)?$ blog-yazi.php?slug=$1 [L,QSA]

  # Uzantısız adresler: /hakkimizda -> hakkimizda.html, /blog/yazi -> blog/yazi.html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.+)$ $1.html [L]
</IfModule>

# Yüklenen medya için tarayıcı önbelleği
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType video/mp4 "access plus 30 days"
  ExpiresByType video/webm "access plus 30 days"
</IfModule>
